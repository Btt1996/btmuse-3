# Btt Music 2.00 — X2 Backend & Companion Provider Configuration
#
# All three variables are configuration values (URLs), NEVER private third-party developer keys.
# Do NOT expose private backend credentials inside Flutter source code or client logs.

# 1. Deployed Btt Music X2 Backend URL (leave empty if not yet deployed; NEVER invent a URL)
# Example once deployed: X2_BACKEND_URL="https://btmu-backend.example.com"
X2_BACKEND_URL=""

# 2. Optional comma-separated Piped API instance URLs (probed for health with automatic failover)
# Example: PIPED_API_URL="https://pipedapi.example1.org,https://pipedapi.example2.org"
PIPED_API_URL=""

# 3. Optional comma-separated Invidious API instance URLs (probed via /api/v1/stats with automatic failover)
# Example: INVIDIOUS_API_URL="https://invidious.example1.org,https://invidious.example2.org"
INVIDIOUS_API_URL=""

# Optional shared token if your deployed X2 backend enforces authenticated client access
X2_BACKEND_AUTH_TOKEN=""

# Hosting runtime URL
APP_URL="http://localhost:3000"
